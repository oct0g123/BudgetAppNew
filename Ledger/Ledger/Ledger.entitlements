<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  iCloud / CloudKit requires a PAID Apple Developer Program membership.
	  When you have one, set `enableCloudKitSync = true` in LedgerApp.swift, add
	  the iCloud capability (CloudKit) in Signing & Capabilities, and uncomment
	  the keys below (update the container id to match yours):

	  <key>com.apple.developer.icloud-container-identifiers</key>
	  <array>
	      <string>iCloud.com.example.Ledger</string>
	  </array>
	  <key>com.apple.developer.icloud-services</key>
	  <array>
	      <string>CloudKit</string>
	  </array>
	-->

	<!-- macOS sandbox: lets the Mac build read/write user-picked files for
	     JSON/CSV export & import. Harmless / ignored on iOS. No paid account
	     required. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
